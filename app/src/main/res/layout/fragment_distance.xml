<?xml version="1.0" encoding="utf-8"?>
<!-- §6.1.1 Main True Distance Screen — Destination selection, Search Autocomplete, and Start Tracking -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_soft"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- §11.1 No Internet Warning Banner (Gone by default) -->
        <TextView
            android:id="@+id/noInternetBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/accent_warm"
            android:padding="8dp"
            android:text="@string/no_internet_banner"
            android:textColor="@android:color/white"
            android:textAlignment="center"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- §11.2 No GPS / Location Disabled Warning Banner (Gone by default) -->
        <TextView
            android:id="@+id/noGpsBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/accent_warm"
            android:padding="8dp"
            android:text="@string/no_gps_banner"
            android:textColor="@android:color/white"
            android:textAlignment="center"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/noInternetBanner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Screen Header Title -->
        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:text="@string/true_distance"
            android:textColor="@color/text_charcoal"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/noGpsBanner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/savedLocationsButton" />

        <!-- Header Action Chip: Saved Locations Shortcut -->
        <ImageButton
            android:id="@+id/savedLocationsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_icon_chip"
            android:contentDescription="@string/saved_locations"
            android:src="@drawable/ic_bookmark"
            app:layout_constraintTop_toBottomOf="@id/noGpsBanner"
            app:layout_constraintEnd_toStartOf="@id/historyButton" />

        <!-- Header Action Chip: Distance History Shortcut -->
        <ImageButton
            android:id="@+id/historyButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_icon_chip"
            android:contentDescription="@string/distance_history"
            android:src="@drawable/ic_history"
            app:layout_constraintTop_toBottomOf="@id/noGpsBanner"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- §6.1.1 Main Location & Destination Selection Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/locationCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_white"
            app:layout_constraintTop_toBottomOf="@id/historyButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_max="600dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Destination Input Bar: Places Autocomplete + Map Picker + Saved Locations Dropdown -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Places Autocomplete Search Input -->
                    <AutoCompleteTextView
                        android:id="@+id/destinationSearchBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/search_destination_hint"
                        android:inputType="text"
                        android:completionThreshold="1"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:importantForAutofill="no" />

                    <!-- Map Picker Action Button -->
                    <ImageButton
                        android:id="@+id/mapPickButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_icon_chip"
                        android:contentDescription="@string/pick_on_map"
                        android:src="@drawable/ic_map_pin" />

                    <!-- Saved Locations Quick Selection Dropdown Button -->
                    <ImageButton
                        android:id="@+id/savedLocationDropdown"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_icon_chip"
                        android:contentDescription="@string/saved_locations"
                        android:src="@drawable/ic_chevron_down" />
                </LinearLayout>

                <!-- Current Location Origin Label -->
                <TextView
                    android:id="@+id/fromLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/from_current_location"
                    android:textStyle="bold" />

                <!-- Selected Destination Destination Label -->
                <TextView
                    android:id="@+id/toLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/to_choose_destination" />

                <!-- Start Tracking Action Button (Disabled until destination selected) -->
                <Button
                    android:id="@+id/startTrackingButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:enabled="false"
                    android:alpha="0.4"
                    android:text="@string/start_tracking" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
