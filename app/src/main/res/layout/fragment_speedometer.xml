<?xml version="1.0" encoding="utf-8"?>
<!-- §6.2 Speedometer Screen — Live trip tracking with map, floating speed, and stats card -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_soft">

    <!-- Header row with Screen Name on left and History Action Chip on right -->
    <TextView
        android:id="@+id/screenTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:text="@string/speedometer"
        android:textColor="@color/text_charcoal"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/historyButton" />

    <ImageButton
        android:id="@+id/historyButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_icon_chip"
        android:contentDescription="@string/past_trips"
        android:src="@drawable/ic_history"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Map with soft rounded border and whitespace margin from header -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mapCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/historyButton"
        app:layout_constraintBottom_toTopOf="@id/statsCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="600dp">

        <fragment
            android:id="@+id/mapContainer"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Map controls stack: Current Location (top), Zoom + (mid), Zoom - (bottom) -->
        <LinearLayout
            android:id="@+id/mapControlsStack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnMyLocation"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_chip"
                android:contentDescription="@string/recenter"
                android:src="@drawable/ic_recenter"
                app:tint="@color/primary_violet" />

            <ImageButton
                android:id="@+id/btnZoomIn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_icon_chip"
                android:contentDescription="Zoom In"
                android:src="@drawable/ic_add"
                app:tint="@color/primary_violet" />

            <ImageButton
                android:id="@+id/btnZoomOut"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_icon_chip"
                android:contentDescription="Zoom Out"
                android:src="@drawable/ic_minus"
                app:tint="@color/primary_violet" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Floating Live Speed Counter Overlay -->
    <androidx.cardview.widget.CardView
        android:id="@+id/speedOverlayCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/card_white_translucent"
        app:layout_constraintTop_toTopOf="@id/mapCard"
        app:layout_constraintStart_toStartOf="@id/mapCard"
        app:layout_constraintEnd_toEndOf="@id/mapCard">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:gravity="center">

            <TextView
                android:id="@+id/speedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="000"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/text_charcoal" />

            <TextView
                android:id="@+id/speedUnitText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M/H"
                android:textSize="13sp"
                android:textColor="@color/text_secondary_contrast" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Gradient Stats Card -->
    <FrameLayout
        android:id="@+id/statsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card_lavender"
        app:layout_constraintBottom_toTopOf="@id/controlsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="600dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Row 1: Distance Covered Header & Value -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/distanceCoveredLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/stat_distance"
                    android:textSize="14sp"
                    android:drawableStart="@drawable/ic_distance"
                    android:drawablePadding="6dp"
                    android:textColor="@color/text_secondary_contrast" />

                <TextView
                    android:id="@+id/distanceCoveredText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 M"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_charcoal" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#1A000000" />

            <!-- Row 2: Average Speed & Max Speed -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/avgSpeedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_avg_speed"
                        android:textSize="12sp"
                        android:drawableStart="@drawable/ic_avg_speed"
                        android:drawablePadding="4dp"
                        android:textColor="@color/text_secondary_contrast" />

                    <TextView
                        android:id="@+id/avgSpeedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 M/H"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_charcoal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/maxSpeedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_max_speed"
                        android:textSize="12sp"
                        android:drawableStart="@drawable/ic_max_speed"
                        android:drawablePadding="4dp"
                        android:textColor="@color/text_secondary_contrast" />

                    <TextView
                        android:id="@+id/maxSpeedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 M/H"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_charcoal" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 3: Start Time & Elapsed Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/startTimeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_start_time"
                        android:textSize="12sp"
                        android:drawableStart="@drawable/ic_clock"
                        android:drawablePadding="4dp"
                        android:textColor="@color/text_secondary_contrast" />

                    <TextView
                        android:id="@+id/startTimeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--:--:--"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_charcoal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/elapsedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_elapsed"
                        android:textSize="12sp"
                        android:drawableStart="@drawable/ic_timer"
                        android:drawablePadding="4dp"
                        android:textColor="@color/text_secondary_contrast" />

                    <TextView
                        android:id="@+id/elapsedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00:00"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_charcoal" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Controls Container -->
    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="600dp">

        <!-- Idle state: Start button -->
        <Button
            android:id="@+id/startTripButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_start"
            app:backgroundTint="@color/primary_violet" />

        <!-- Active state: Pause/Resume + Stop buttons -->
        <LinearLayout
            android:id="@+id/activeControlsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/pauseResumeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/action_pause"
                app:backgroundTint="@color/primary_violet" />

            <Button
                android:id="@+id/stopTripButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/action_stop"
                app:backgroundTint="@color/primary_violet" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
