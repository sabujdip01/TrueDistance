<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- §9 Visual Style Guide / §12 Theming: Light/Dark/System via DayNight -->
    <style name="Theme.TrueDistance" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_warm</item>
        <item name="android:windowBackground">@color/background_soft</item>
    </style>

    <!-- §5.2 Splash Screen theme -->
    <style name="Theme.TrueDistance.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_soft</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.TrueDistance</item>
    </style>
</resources>
